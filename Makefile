# Load environment from .env file
ifneq (,$(wildcard .env))
    include .env
    export
endif

.PHONY: default clean build run container-build container-run container

# Just run application
default:
	LOG_LEVEL=DEBUG KEMAL_ENV=development crystal run src/streamiau.cr

# Remove all files generated by build
clean:
	@rm -rf public/*
	@rm -rf src/streamiau/views/*
	@rm bin/*

# Build dependencies (frontend) then main app
build:
	@if [ ! -d ../streamiau-astro ]; then cd ../streamiau-astro && bun astro build; fi
	@if [ ! -d ../streamiau-pages-counter ]; then cd ../streamiau-pages-counter && bun run build; fi
	@mkdir -p bin
	crystal run src/streamiau.cr -o bin/streamiau

# Run builded app
run:
	LOG_LEVEL=DEBUG KEMAL_ENV=development ./bin/streamiau

container-build:
	podman build -t streamiau .

container-run:
	podman run --env-file .env -p 3000:3000 streamiau

# make container → do build then run container
container: container-build container-run
